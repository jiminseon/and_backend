MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MYSQL_PASSWORD=replace-with-a-different-long-random-password
RABBITMQ_USERNAME=and
RABBITMQ_PASSWORD=replace-with-a-long-random-password

JWT_ISSUER=and-user-service
JWT_AUDIENCE=and-services
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=1209600000

# HTTP IP test only. Change to true after HTTPS is configured.
AUTH_COOKIE_SECURE=false

# Use fake until the Firebase service-account JSON is installed.
ALERT_FCM_MODE=fake
OPENAI_API_KEY=

# Temporary bootstrap setting. Replace with Flyway and set to validate later.
JPA_DDL_AUTO=update

